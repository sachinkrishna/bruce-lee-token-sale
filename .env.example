MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=xfee_sol_sale

# ── Master + Treasury wallets (private keys are SECRETS) ─────────────
MASTER_WALLET_ADDRESS=
MASTER_WALLET_PRIVATE_KEY=
TREASURY_WALLET_ADDRESS=
TREASURY_WALLET_PRIVATE_KEY=

# ── Token + Solana RPC ───────────────────────────────────────────────
XFEE_TOKEN_MINT=
POOL_ADDRESS=
# Base58 private key of the staking pool's authority (the keypair the pool
# was created with). Leave empty to fall back to MASTER_WALLET_PRIVATE_KEY
# for single-keypair deployments. Set this when you want the on-chain pool
# authority to be a separate wallet from the master / commission / global
# pool wallet.
POOL_AUTHORITY_PRIVATE_KEY=
# Base58 program ID of the POWER staking program. Leave empty to use the
# built-in default (EX7YLYMv9pjarwgFF8JN5kwSohuhgVVmTDfD31ETekBC). Override
# only if this deployment targets a different staking program deployment.
STAKING_PROGRAM_ID=

QUICKNODE_RPC_URL=
SOL_PRICE_API_URL=

# 1 XFEE = $1 USD (hard-coded). XFEE_TOTAL_SUPPLY is a display-only cap for /stats/global.
# Set to 0 (or any negative number) for an unlimited sale — tokens_remaining is reported as null.
XFEE_TOTAL_SUPPLY=0

PURCHASE_WALLET_EXPIRY_MINUTES=15
PURCHASE_MIN_USD=6.00
GAS_BUFFER_USD=5.00
LEAVE_IN_PURCHASE_WALLET_USD=4.50

# ── Multi-currency purchase mode ──────────────────────────────────────
# The active mode is stored in Mongo (`system_meta._id="purchase_mode"`)
# and toggled via POST /api/v1/admin/purchase-mode. This env var is only
# used to bootstrap the mode on a fresh deployment. Valid: SOL | XFEE.
DEFAULT_PURCHASE_MODE=SOL

# SPL token mint accepted as payment when purchase mode is "XFEE".
# For the XFEE ecosystem token this is 96egraTCizRpzNx4WvMMhPJf7TKS7W5kUHeenmd1XfuN.
XFEE_PAYMENT_TOKEN_MINT=
XFEE_PAYMENT_TOKEN_DECIMALS=9
# Oracle URL that returns a JSON body containing the current XFEE/USD price.
# XFEE_PRICE_ORACLE_JSON_PATH is a dotted path into the response (e.g. "data.price").
XFEE_PRICE_ORACLE_URL=https://xtrends-data-f107.datafeed.cc/api/tokens/96egraTCizRpzNx4WvMMhPJf7TKS7W5kUHeenmd1XfuN
XFEE_PRICE_ORACLE_JSON_PATH=data.price
XFEE_PRICE_CACHE_TTL_SECONDS=30
# SOL gas buffer the buyer must include alongside their XFEE payment on the
# ephemeral wallet so the backend can afford commission + sweep tx fees.
XFEE_MODE_SOL_GAS_BUFFER_SOL=0.02
# Tolerance for detecting the required XFEE amount before triggering the flow.
XFEE_MODE_RECEIVE_TOLERANCE=0.95

# ── Admin auth ───────────────────────────────────────────────────────
# Required for all /admin endpoints
ADMIN_API_KEY=

# Optional: separate Solana wallet (base58 pubkey) authorized to sign
# POST /api/v1/admin/set-user-level requests. When empty, master wallet is used.
# Independent of ADMIN_API_KEY (header-based auth still works regardless).
SET_USER_LEVEL_SIGNER_WALLET=

# ── Root-child enforcement (optional legacy feature) ─────────────────
# When ENFORCE_ROOT_CHILD=true, the master wallet can only refer the
# configured ROOT_CHILD_WALLET_ADDRESS, and that wallet has at most
# ROOT_CHILD_MAX_DIRECT_REFERRALS direct referrals. Defaults to false;
# leave that way unless you specifically need this behavior.
ROOT_CHILD_WALLET_ADDRESS=
ROOT_CHILD_LEVEL=14
ROOT_CHILD_MAX_DIRECT_REFERRALS=1
ENFORCE_ROOT_CHILD=false

# ── Burn dashboard (optional) ────────────────────────────────────────
# Wallets scanned by /api/v1/burn/*. Leave empty if this deployment doesn't
# publish burn stats — the /burn/summary endpoint will return an empty list.
BURN_TOKEN_BUY_WALLET=
BURN_FEE_WALLET=

# ── Test mode — set to true to mock all Solana interactions ──────────
TEST_MODE=false
TEST_SOL_PRICE=150.00

# ── POWER staking ────────────────────────────────────────────────────
# Set false to pause POWER staking while keeping purchases and commissions live
POWER_DISTRIBUTION_ENABLED=true

# Bonus multiplier for purchases made while POWER distribution was disabled.
# Example: 1.25 means a $100 purchase receives 2500 POWER instead of 2000.
POWER_DELAYED_STAKE_BONUS_MULTIPLIER=1.00

# ── Global pool ──────────────────────────────────────────────────────
# Direct auto-settlement from the funding wallet (no on-chain program)
GLOBAL_POOL_ENABLED=true
GLOBAL_POOL_DURATION_DAYS=15
# How often the worker scans for pools whose window has ended.
GLOBAL_POOL_FINALIZE_INTERVAL_SECONDS=300
# Base58 64-byte secret key of the funding wallet (typically the master/top wallet).
# This wallet pays both the SOL payouts and the network fees.
GLOBAL_POOL_FUNDING_WALLET_PRIVATE_KEY=
# SOL reserve left in the funding wallet after settlement (covers network fees + safety).
GLOBAL_POOL_FUNDING_BUFFER_SOL=0.05
# How many user payouts to send in parallel from the funding wallet.
GLOBAL_POOL_SETTLEMENT_CONCURRENCY=3
# How many times to poll signature status before treating a tx as unconfirmed.
GLOBAL_POOL_CONFIRM_RETRIES=30
